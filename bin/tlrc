#!/usr/bin/bash
# Upstream: https://github.com/klapptnot/kitsh
# SPDX-License-Identifier: AGPL-3.0-or-later

source logger.sh
source barg.sh

declare -ag lyric_lines=()
declare -g mpv_pid=''

function cleanup {
  printf '\x1b[?25h\x1b[0H\x1b[3J'
  kill "${mpv_pid}" > /dev/null 2>&1
  unlink "${LYR_MPV_SOCKET:?}"
  kill 0 > /dev/null 2>&1
}

function mpv_socat {
  printf "${1}\n" "${@:1}" | socat - "${LYR_MPV_SOCKET}"
}

function record_timestamps {
  local output_file="${1}"

  local last_timestamp='0.0'
  local timestamps=()
  local timestamped=()
  local sec_with_ms elapsed_sec elapsed_min
  for ll in "${lyric_lines[@]}" '[:end of lyrics:]' '[:finish:]'; do
    printf '\x1b[38;5;242m[00:00.00] %s\x1b[0m\n' "${ll}"
  done
  printf '\x1b[%dA\x1b[0G\x1b[?25l' "$((2 + ${#lyric_lines[@]}))"
  while read -rsN 1 c && ((${#timestamps[@]} <= ${#lyric_lines[@]})); do
    case "${c}" in
      'o') ;; # fall-through (add timed line)
      'p')
        mpv_socat "cycle pause"
        continue
        ;;
      'i')
        if ((${#timestamps[@]} > 0)); then
          unset 'timestamps[-1]' 'timestamped[-1]'
          printf '\x1b[1A\x1b[0G\x1b[0K\x1b[38;5;242m[00:00.00] %s\x1b[0m\x1b[0G' \
            "${lyric_lines[${#timestamps[@]}]}"
          ((${#timestamps[@]} > 0)) && last_timestamp="${timestamps[-1]:-0.0}"
        fi
        mpv_socat '{"command": ["set_property", "time-pos", %d]}' "${last_timestamp:=0.0}" &> /dev/null
        continue
        ;;
      'r') return 1 ;;
      *) continue ;;
    esac

    read -r elapsed_sec < <(mpv_socat '{"command": ["get_property", "time-pos"]}' | jq -r '.data')
    [[ "${elapsed_sec}" == "null" || -z "${elapsed_sec}" ]] && elapsed_sec="0.00"

    read -r sec_with_ms < <(awk "BEGIN {printf \"%.2f\", ${elapsed_sec} % 60}")
    elapsed_sec="${elapsed_sec%%.*}"
    elapsed_min=$((elapsed_sec / 60))

    printf -v tmped '[%02d:%05.2f] %s' "${elapsed_min}" "${sec_with_ms}" "${lyric_lines[${#timestamps[@]}]}"
    timestamps+=("${elapsed_sec}")
    timestamped+=("${tmped}")
    printf '\x1b[0G\x1b[0K%s\n' "${tmped}"
    printf '\x1b[38;5;242m[00:00.00] %s\x1b[0m\x1b[0G' "${lyric_lines[${#timestamps[@]}]}"
  done

  log::info 'All lyrics lines have been timestamped.'

  printf '[00:00.00] \n' > "${output_file}"
  printf '%s\n' "${timestamped[@]:1}" >> "${output_file}"
}

function main {
  barg::parse "${@}" << 'BARG'
  #[always]
  meta {
    summary: "Create a timed lyrics file"
    help_enabled: true
    show_defaults: true
  }

  ! s/song :str  => LYR_SONG_FILE "Audio file for playback"
  ! i/input :str  => LYR_INPUT_FILE "Input text file with lyrics"
  ! o/output :str => LYR_OUTPUT_FILE "Output file for timed lyrics"
  m/mpv-socket :str "/tmp/mpv_socket" => LYR_MPV_SOCKET "Socket for mpv player"
  f/force :flag => LYR_FILE_OVERWRITE "Overwrite output file if not empty"
BARG
  barg::unload

  if [[ ! -f "${LYR_INPUT_FILE}" || ! -f "${LYR_SONG_FILE}" ]]; then
    log::err "Missing input file or song file. Please check paths."
    exit 1
  fi

  local lyric_lines=('[:marker:]')
  mapfile -tO1 lyric_lines < "${LYR_INPUT_FILE}"

  if [[ ${#lyric_lines[@]} -eq 0 ]]; then
    log::err "Input file is empty."
    exit 1
  fi

  log::info "Output will be saved to: %s" "${LYR_OUTPUT_FILE}"
  if [[ -s "${LYR_OUTPUT_FILE}" ]]; then
    if ! ${LYR_FILE_OVERWRITE}; then
      log::err "Output file exists and is not empty."
      log::info 'Use -f/--force to overwrite this file.'
      exit 1
    fi
    log::info 'Output file is not empty, will be overwritten.'
  fi

  log::info "Playing song: %s" "${LYR_SONG_FILE}"

  trap cleanup SIGINT

  mpv --no-video --input-ipc-server="${LYR_MPV_SOCKET}" "${LYR_SONG_FILE}" &> /dev/null &
  mpv_pid="${!}"

  while true; do
    mpv_socat '{ "command": ["seek", "-9999"] }' &> /dev/null \
      && printf '\x1b[0H\x1b[3J' \
      && log::info 'Press o key to timestamp the next lyric line...'

    record_timestamps "${LYR_OUTPUT_FILE}" && break
  done

  kill -s SIGINT 0 > /dev/null 2>&1
}

main "${@}"
